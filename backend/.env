# Settings
PROJECT_NAME="BookBrain Agentic RAG"
API_V1_STR="/api/v1"

# LLM Providers (Active: 'gemini', 'openai', or 'opencode')
ACTIVE_PROVIDER="opencode"

# Google Gemini API Config
GOOGLE_API_KEY=""
GEMINI_API_KEY=""
GOOGLE_BOOKS_API_KEY=""

# OpenCode API Config
OPENCODE_API_KEY=""
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_MODEL="deepseek-v4-flash"

# Google Drive Integration Config
GDRIVE_SERVICE_ACCOUNT_FILE=".json"

# Retrieval Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
FAISS_INDEX_PATH="data/faiss_index"
MILVUS_DB_PATH="data/milvus_books.db"
MILVUS_COLLECTION_NAME="book_chunks"

# LangSmith Tracing
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="BookBrain"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=''

